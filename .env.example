# ClubTreasury AI environment template
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets.

# App
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI — mock mode is the safe/default development mode
AI_MODE=mock

# Gemini — server only. Keep blank/disabled for normal development and CI.
# Owner-controlled live validation must set live mode + true guard + a local key together.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_REQUESTS_ENABLED=false

# Sui — public Testnet deployment configuration
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_SUI_PACKAGE_ID=0xfbb2f939d484b6179f555a6cef8093faa749001184d84adb980de6d88c0e1d4f
NEXT_PUBLIC_SUI_USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
NEXT_PUBLIC_SUI_EXPLORER_TX_URL=https://suiscan.xyz/testnet/tx/
NEXT_PUBLIC_DEMO_TREASURY_OBJECT_ID=0x8971fa3e32994b81396122c3e3b1a4b054c3e3799714f5c2206dd037054319e4

# Supabase
NEXT_PUBLIC_CLAIM_DATA_MODE=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts
