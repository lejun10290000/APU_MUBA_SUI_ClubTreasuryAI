# ClubTreasury AI environment template
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets.

# App
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI — server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_RECEIPT_IMAGE_DETAIL=original
OPENAI_STORE_RESPONSES=false

# Sui — public network configuration
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_SUI_PACKAGE_ID=
NEXT_PUBLIC_SUI_USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
NEXT_PUBLIC_SUI_EXPLORER_TX_URL=https://suiscan.xyz/testnet/tx/
NEXT_PUBLIC_DEMO_TREASURY_OBJECT_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts
